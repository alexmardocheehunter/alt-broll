# =====================================================================
# ALT B-ROLL : variables d'environnement (MODÈLE, aucune vraie valeur)
# =====================================================================
# 1. Copier ce fichier en ".env" à la racine du projet (à côté de celui-ci).
# 2. Renseigner les clés. Ne JAMAIS committer .env ni partager une clé.
# Le même .env est lu par le backend (backend/) et par le worker (renderer/).
# Les chemins relatifs sont résolus depuis la racine du projet.
# Une variable déjà définie dans le shell a priorité sur ce fichier.

# ---------------------------------------------------------------------
# Commun backend + worker
# ---------------------------------------------------------------------
# development | test | production (en production, les clés API sont obligatoires)
NODE_ENV=development
# Base SQLite : projets + table render_jobs (protocole : shared/README.md)
DATABASE_PATH=./backend/data/alt-broll.sqlite
# Fichiers des projets : <STORAGE_ROOT>/projects/<projectId>/...
STORAGE_ROOT=./storage
# Exécutables FFmpeg : nom présent dans le PATH ou chemin absolu
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---------------------------------------------------------------------
# Backend (backend/, Claude Code)
# ---------------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
# URL publique du backend (sert à construire les liens média et de téléchargement)
APP_BASE_URL=http://localhost:3000
# Origines autorisées par CORS, séparées par des virgules
FRONTEND_ORIGIN=http://localhost:5500
# Derrière un tunnel ou un proxy HTTPS (D-10) : loopback si le tunnel tourne sur cette machine,
# sinon le nombre de proxys (1 à 9). false : l'adresse retenue est celle de la connexion.
TRUST_PROXY=false
# debug | info | warn | error
LOG_LEVEL=info

# Transcription : Groq Whisper
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Analyse texte + image : OpenRouter. Choisir un modèle qui accepte réellement les images.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Recherche de B-rolls : Pixabay
PIXABAY_API_KEY=

# Limites de la bêta (appliquées côté serveur)
MAX_UPLOAD_MB=150
MIN_VIDEO_DURATION_SECONDS=5
MAX_VIDEO_DURATION_SECONDS=180
# Petit côté maximal de l'export : 720 ou 1080
RENDER_MAX_SHORT_SIDE=1080
# Créations de projet, imports, analyses et exports autorisés par heure et par adresse IP
RATE_LIMIT_WRITES_PER_HOUR=60

# ---------------------------------------------------------------------
# Worker de rendu (renderer/) : section gérée par Codex
# ---------------------------------------------------------------------
MAX_CONCURRENT_RENDERS=1
